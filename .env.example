# Copy to `.env` (gitignored) and `source .env` before running the harness.

# --- SIE cloud (recommended) -------------------------------------------------
# Create a key in the console at console.superlinked.com (Keys page).
export SIE_API_KEY="sk-sie-..."
export SIE_BASE_URL="https://api.superlinked.com"     # EU: https://eu.api.superlinked.com

# Optional model overrides -- browse superlinked.com/models or the console playground.
export SIE_GENERATE_MODEL="Qwen/Qwen2.5-Coder-7B-Instruct"
export SIE_ENCODE_MODEL="Qwen/Qwen3-Embedding-4B"
# export SIE_SCORE_MODEL="BAAI/bge-reranker-v2-m3"
# export SIE_EXTRACT_MODEL="urchade/gliner_multi-v2.1"

# --- Local alternative (no key; Apple Silicon friendly) ----------------------
# pip install "sie-server[local]"   (Python 3.12)   then:  sie-server serve
# export SIE_BASE_URL="http://localhost:8080"
# Generation runs as a separate MLX server on :8081, so also set:
# export SIE_GENERATE_URL="http://localhost:8081"
